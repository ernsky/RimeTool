/* 五笔词库编辑器样式表（设计令牌由 core.config.THEME 注入）。
   变量由 main.py 用 string.Template 注入（见 core.config.THEME）。
   字号不写死，跟随系统默认并随高 DPI 缩放。 */

QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Microsoft YaHei UI";
    color: $text_primary;
}

/* ========== 字号规范：标题 / 小字 ========== */
QLabel[class="title"] {
    font-size: 14px;
    font-weight: bold;
    color: $text_primary;
}
QLabel[class="small"] {
    font-size: 11px;
    color: $text_tertiary;
}

QMainWindow {
    background-color: $panel;
}

/* ========== 顶栏工具条：直角、面板底色、下边框 1px ========== */
QFrame#topWidget {
    background-color: $panel;
    border: none;
    border-bottom: 1px solid $border_medium;
    border-radius: 0;
}

/* ========== 表格 ========== */
QTableView {
    background-color: $panel;
    gridline-color: transparent;
    border: none;
    alternate-background-color: $row_odd;
}
QTableView::item {
    padding: 3px 8px;
    /* 内部网格（行/列之间、跳过最外边）改由自定义 delegate 绘制，
       此处不再画 item 边框，避免最后一行/列重复出现外边框 */
}
QTableView::item:hover {
    background-color: $row_hover;
}
QTableView::item:selected {
    background-color: $selected;
    color: $selected_text;
}
/* 选中/聚焦单元格：去掉默认焦点框（focus frame），避免其内容被向内缩进 1~2px */
QTableView::item:focus {
    border: none;
    outline: none;
}
QTableView::item:hover {
    outline: none;
}
QHeaderView {
    background-color: $panel;
}
QHeaderView::section {
    background-color: $panel;
    color: $text_secondary;
    border: none;
    border-right: 1px solid $border_light;
    /* 列头下边框：作为表头与表格区之间的分隔线（曾被"面板边框大重构"移除，此处恢复） */
    border-bottom: 1px solid $border_medium;
    padding: 2px 6px;
}
/* 表格：取消最左(词组列左)、最右(启用列右)外竖线，仅保留列间分隔竖线 */
QHeaderView::section:first { border-left: none; }
QHeaderView::section:last  { border-right: none; }
QTableCornerButton::section {
    background-color: $panel;
    border: none;
    /* 与列头下边框对齐，使角落按钮底部也保留分隔线 */
    border-bottom: 1px solid $border_medium;
}

/* ========== 三栏面板容器背景 ========== */
QWidget#leftWidget, QWidget#midWidget, QWidget#groupPanel {
    background-color: $panel;
}
/* 右侧按钮栏：显式左边界框（与文件树 border-right 对称；不依赖 QSplitter 手柄渲染，
   不受高分屏 DPI 取整影响，1px 恒可见） */
QWidget#rightWidget {
    background-color: $panel;
    border-left: 1px solid $border_medium;
}
QWidget#leftWidget, QWidget#groupPanel {
    background-color: $panel;   /* 与文件树/分组列表同底，右侧留白边距处无缝衔接 */
}

/* ========== 输入控件 ========== */
QLineEdit {
    border: 1px solid $border_light;
    border-radius: $radius;
    padding: 2px 6px;
    background: $input_bg;
    selection-background-color: $selected;
}
QLineEdit:focus {
    border: 1px solid $accent;
}

/* ========== 按钮 4 类 ========== */
QPushButton[class="btn-primary"] {
    background-color: $primary;
    color: #ffffff;
    border: 1px solid $primary_dark;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-primary"]:hover {
    background-color: $primary_hover;
    border-color: $primary_hover;
}
QPushButton[class="btn-primary"]:pressed {
    background-color: $primary_dark;
    padding-top: 3px;
    padding-bottom: 1px;
}

QPushButton[class="btn-ghost"] {
    background-color: transparent;
    color: $text_primary;
    border: 1px solid $border_medium;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-ghost"]:hover {
    background-color: $row_hover;
}
QPushButton[class="btn-ghost"]:pressed {
    background-color: $panel;
    padding-top: 3px;
    padding-bottom: 1px;
}
QPushButton[class="btn-ghost"]:disabled {
    color: $text_disabled;
}

QPushButton[class="btn-main"] {
    background-color: $accent;
    color: white;
    border: 1px solid $accent_hover;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-main"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}
QPushButton[class="btn-main"]:pressed {
    background-color: $primary_dark;
    padding-top: 3px;
    padding-bottom: 1px;
}

QPushButton[class="btn-blue"] {
    background-color: $accent;
    color: white;
    border: 1px solid $accent;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-blue"]:hover {
    background-color: $accent_hover;
    border-color: $accent_hover;
}
QPushButton[class="btn-blue"]:pressed {
    background-color: $primary_dark;
    padding-top: 3px;
    padding-bottom: 1px;
}
QPushButton[class="btn-blue"]:disabled {
    background-color: $panel;
    color: $text_disabled;
    border-color: $border_medium;
}

QPushButton[class="btn-green"] {
    background-color: $success;
    color: white;
    border: 1px solid $success;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-green"]:hover {
    background-color: #059669;
    border-color: #059669;
}
QPushButton[class="btn-green"]:pressed {
    background-color: #047857;
    padding-top: 3px;
    padding-bottom: 1px;
}

QPushButton[class="btn-cyan"] {
    background-color: #2fbcfa;
    color: white;
    border: 1px solid #2fbcfa;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-cyan"]:hover {
    background-color: #16b4f9;
    border-color: #16b4f9;
}
QPushButton[class="btn-cyan"]:pressed {
    background-color: #06a9f0;
    padding-top: 3px;
    padding-bottom: 1px;
}

QPushButton[class="btn-red"] {
    background-color: $error;
    color: white;
    border: 1px solid $error;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-red"]:hover {
    background-color: #dc2626;
    border-color: #dc2626;
}
QPushButton[class="btn-red"]:pressed {
    background-color: #b91c1c;
    padding-top: 3px;
    padding-bottom: 1px;
}
QPushButton[class="btn-red"]:disabled {
    background-color: $panel;
    color: $text_disabled;
    border-color: $border_medium;
}

/* 搜索 / 交换权重 等工具按钮：浅色=蓝，深=#3b3b3b（由 $search_btn 驱动） */
QPushButton[class="btn-search"] {
    background-color: $search_btn;
    color: #ffffff;
    border: 1px solid $search_btn;
    border-radius: $radius;
    padding: 2px 8px;
    min-height: 24px;
}
QPushButton[class="btn-search"]:hover {
    background-color: $search_btn_hover;
    border-color: $search_btn_hover;
}
QPushButton[class="btn-search"]:pressed {
    background-color: $search_btn_press;
    padding-top: 3px;
    padding-bottom: 1px;
}
QPushButton[class="btn-search"]:disabled {
    background-color: $panel;
    color: $text_disabled;
    border-color: $border_medium;
}

QPushButton {
    background-color: $surface;
    color: $text_primary;
    border: 1px solid $border_light;
    border-radius: $radius;
    padding: 3px 10px;
}
QPushButton:hover {
    border-color: $accent;
}
QPushButton:pressed {
    background-color: $panel;
}
QPushButton:disabled {
    color: $text_disabled;
}

/* ========== 下拉 / 组合框 ========== */
QComboBox {
    background-color: $surface;
    color: $text_primary;
    border: 1px solid $border_light;
    border-radius: $radius;
    padding: 2px 6px;
}
QComboBox:focus { border: 1px solid $accent; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    background-color: $raised;
    color: $text_primary;
    selection-background-color: $selected;
    border: 1px solid $border_medium;
}

/* ========== 树 / 列表 ========== */
QTreeWidget, QListWidget {
    background-color: $panel;
    color: $text_primary;
    border: 1px solid $border_medium;
    outline: none;
}

/* 分组列表：取消上下边框，仅保留左右竖线（与"整窗仅留工具栏下、状态栏上横线"一致） */
QListWidget#groupListWidget {
    border: none;
    border-right: 1px solid $border_medium;
}

/* 取消左侧竖线（不再用 border-left 占位）；
   margin：上下 2px 间距；行高亮块左贴边(left=0)、右留 8px，与面板右侧 8px 间距呼应、不连接 */
QTreeWidget::item, QListWidget::item {
    padding: 4px 8px;
    border: none;
    margin: 2px 8px 2px 0;   /* top=2 right=8 bottom=2 left=0 */
}
/* 分组行块：左右各 8px 内缩（与文件树"左0右8"区分） */
QListWidget#groupListWidget::item {
    margin: 2px 8px 2px 0;   /* top=2 right=8 bottom=2 left=0：左贴边、右留 8px */
}
/* hover：只变底色，不出竖线；四个角全回圆角 */
QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: $row_hover;
    border-radius: 6px;
}
/* 选中：软强调底，取消左侧竖线，四个角全回圆角 */
QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: $selected;
    color: $selected_text;
    font-weight: bold;
    border-radius: 6px;
}
QListWidget#groupListWidget::item:selected {
    background-color: $selected;
    color: $selected_text;
    font-weight: bold;
    border-radius: 6px;
}
QTreeWidget {
    border-right: 1px solid $border_medium;
}

/* 右栏占位面板 */
QLabel#rightPlaceholder {
    background-color: $panel;
    border-left: 1px solid $border_medium;
    color: $text_tertiary;
    font-size: 11px;
}

/* ========== 状态栏 ========== */
QStatusBar {
    background-color: $panel;
    color: $status_text;
    border-top: 1px solid $border_medium;
    min-height: 30px;
    font-size: 8pt !important;
}
QStatusBar QLabel {
    color: $status_text;
}
QStatusBar QLabel[class="footer-num"] {
    color: $status_text;
    font-weight: bold;
    margin-left: 2px;
    margin-right: 10px;
}
QStatusBar QLabel[class="footer-name"] {
    color: $status_text;
    margin-left: 6px;
}
QStatusBar QLineEdit[class="footer-name"] {
    background: transparent;
    border: none;
    color: $status_text;
    padding: 0 6px 0 2px;
    font-size: 7pt;
}

/* ========== 分组标签 ========== */
QLabel#groupLabel {
    font-size: 13px;
    color: $text_secondary;
    font-weight: bold;
    padding: 4px 8px;
    background-color: $panel;
}

/* ========== 分隔条 / 滚动条 ========== */
QSplitter {
    handle-width: 1px;
    border: none;
}
QSplitter::handle {
    background: $border_medium;
    border: none;
    margin: 0;
    width: 1px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: $panel;
    border: none;
    margin: 0;
}
QScrollBar::groove {
    background: $panel;
    border: none;
}
QScrollBar::handle {
    background: $border_medium;
    border-radius: 4px;
    min-width: 10px;
    min-height: 10px;
}
QScrollBar::handle:hover {
    background: $border_dark;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: none;
    border: none;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}
QAbstractScrollArea::corner {
    background: $panel;
    border: none;
}

/* ========== 对话框 ========== */
QDialog {
    background-color: $raised;
    color: $text_primary;
}
/* 分组框：抬升层底色（与对话框同层、靠边框区分），标题用强调蓝 */
QGroupBox {
    background-color: $surface;
    border: 1px solid $border_light;
    border-radius: $radius;
    margin-top: 14px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: $accent;
    font-weight: bold;
}
ConfigDialog QPushButton:hover {
    border-color: $accent;
}
/* 浏览按钮：ghost 描边风格统一（默认 QPushButton 样式已足够，这里仅保证 hover 一致） */
ConfigDialog QLineEdit {
    background-color: $input_bg;
    color: $text_primary;
}
ConfigDialog QListWidget::item:selected {
    background-color: $selected;
    color: $selected_text;
    border-left: 3px solid $side_active;
}
/* 新建编码弹窗：字段标签用次级灰，与下拉框/输入框的近白色「值」区分，避免混同 */
QDialog#WubiEncodeDialog QLabel {
    color: $text_secondary;
}

/* ========== 多行文本 ========== */
QTextEdit, QPlainTextEdit {
    background-color: $surface;
    color: $text_primary;
    border: 1px solid $border_light;
    border-radius: $radius;
    padding: 2px 6px;
    selection-background-color: $selected;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid $accent;
}
QTextEdit[readOnly="true"], QPlainTextEdit[readOnly="true"] {
    background-color: $panel;
    color: $text_secondary;
}

/* ========== 复选 / 单选 ========== */
QCheckBox, QRadioButton {
    color: $text_primary;
    spacing: 4px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid $border_light;
    background-color: $surface;
}
QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
    border: 1px solid $accent;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    border: 1px solid $accent;
    background-color: $accent;
}
QRadioButton::indicator {
    border-radius: 7px;
}
QCheckBox::indicator {
    border-radius: 3px;
}

/* ========== 对话框标题 ========== */
QLabel#dlgTitle {
    font-size: 13px;
    font-weight: bold;
    color: $title_text;
}

/* ========== 左侧目录树 ========== */
QTreeWidget#fileTree {
    background-color: $panel;
    color: $text_primary;
    /* 取消上下边框；仅保留右侧竖边框，作文件树与内容区分隔；整窗仅留工具栏下、状态栏上两条横线 */
    border: none;
    border-right: 1px solid $border_medium;
}
QTreeWidget#fileTree::item {
    padding-left: 4px;   /* 左内边距减半(8→4)，文件项再左移半格 */
}
QTreeWidget#fileTree::item:selected {
    background-color: $selected;   /* 采用分组区选中背景样式，两套面板统一 */
    color: $selected_text;
    font-weight: bold;
}

/* ========== 输入框占位符（#8：补全主题变量化） ========== */
QLineEdit::placeholder {
    color: $text_tertiary;
}

/* ========== 菜单（#8：原生右键/下拉菜单跟主题） ========== */
QMenu {
    background-color: $raised;
    color: $text_primary;
    border: 1px solid $border_medium;
    border-radius: $radius;
    padding: 4px;
}
QMenu::item {
    padding: 4px 24px 4px 12px;
    border-radius: $radius;
}
QMenu::item:selected {
    background-color: $selected;
    color: $selected_text;
}
QMenu::item:disabled {
    color: $text_disabled;
}
QMenu::separator {
    height: 1px;
    background: $border_light;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
}

/* ========== 工具提示（#8） ========== */
QToolTip {
    background-color: $raised;
    color: $text_primary;
    border: 1px solid $border_medium;
    border-radius: $radius;
    padding: 4px 8px;
}

/* ========== 消息框（#8：弹窗跟主题，不靠仅 DWM 暗色标题栏兜底） ========== */
QMessageBox {
    background-color: $raised;
    color: $text_primary;
}
QMessageBox QLabel {
    color: $text_primary;
    background-color: transparent;
}
