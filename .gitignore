# ============================================================
#  RimeTool 仓库 .gitignore
# ============================================================

# ---------- Python 缓存 / 测试产物 ----------
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---------- 运行日志 / 备份 / 运行时输出 ----------
# Logs/ 由程序写入，含大量 *.bak.gz 备份与运行日志
/Logs/

# ReadMe 资源
resources/ReadMe/*.md

# 运行时导出目录
/Outputs/
*.json

# 日志与临时文件
*.log
*.bak
*.bak.gz
*.tmp
~$*

# ---------- 打包 / 构建产物 ----------
# PyInstaller / 其它打包产出
/build/
/dist/
/_internal/
*.spec

# 打包后的二进制
*.exe

# 第三方/编译的二进制依赖（若仓库自带 Rime 引擎 dll 请删除对应行）
*.dll
*.dylib

# -------------- 数据词库 -------------
# 运行期导出的词库（若仓库自带基础词库需提交，请删除或改为 /Outputs/**/*.tsv）
*.tsv

# ---------- 编辑器 / 系统文件 ----------
.idea/
.vscode/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
